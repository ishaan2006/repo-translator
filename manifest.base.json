{
  "manifest_version": 3,
  "name": "Repo Translator",
  "version": "1.2.1",
  "description": "Translates non-English GitHub READMEs, descriptions, issues and PRs into English with Claude, leaving code untouched.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Repo Translator settings", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://api.anthropic.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dom.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
